# Telegram
BOT_TOKEN=
CHAPA_PROVIDER_TOKEN=
# Chapa Transfer API secret (CHASECK-... from Chapa Dashboard → Settings → API).
# NOTE: this is NOT the same as CHAPA_PROVIDER_TOKEN above — the provider token
# only accepts Telegram invoice payments, while this secret key sends money OUT
# via the Transfer API (weekly referral cash payouts). Leave empty to disable payouts.
CHAPA_SECRET_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontends
WEBAPP_URL=
ADMIN_DASHBOARD_URL=

# Optional
WEBHOOK_URL=
WEBHOOK_SECRET=
ADMIN_CHANNEL_ID=

# Server
PORT=8788

# Seeding (npm run seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=